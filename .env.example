# =============================================================================
# Lodgwise AI — Environment Configuration Template
# Copy to `.env` for local development. Never commit real secrets.
# =============================================================================

# --- Environment ---
APP_ENV=development
LOG_LEVEL=debug

# --- Web (apps/web) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- API (apps/api) ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-real-environments
API_CORS_ORIGINS=http://localhost:3000

# --- Auth ---
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://lodgwise:lodgwise@localhost:5432/lodgwise
POSTGRES_USER=lodgwise
POSTGRES_PASSWORD=lodgwise
POSTGRES_DB=lodgwise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (cache / queues) ---
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Worker (services/worker — arq) ---
WORKER_MAX_JOBS=10
WORKER_MAX_TRIES=3
WORKER_JOB_TIMEOUT_SECONDS=300
WORKER_RETRY_DELAY_SECONDS=15

# --- Object storage (S3-compatible) ---
S3_ENDPOINT_URL=
S3_BUCKET=lodgwise-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI services (services/ai) ---
AI_SERVICE_URL=http://localhost:8100
LLM_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=stub
EMBEDDING_DIMENSIONS=1536

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email / notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@lodgwise.ai

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
